# Skopíruj do .env.local a doplň hodnoty (Supabase → Project Settings → API). Nikdy necommitovať .env*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Len na serveri (seed, riadiace centrum, cron). Nikdy nie s prefixom NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Doména platformy, z ktorej sa odvodzujú subdomény klientov (napr. booking.obrazne.sk).
NEXT_PUBLIC_PLATFORM_DOMAIN=
# Lokálny vývoj: klient, ktorý sa použije na localhost (slug z tabuľky tenant_domains).
DEV_TENANT_HOST=
# Transakčné e-maily (Resend). Len na serveri.
RESEND_API_KEY=
# Adresa aplikácie (odkazy do administrácie v e-mailoch). Staging: https://booking-platform-obrazne.vercel.app
APP_URL=
# Staging: všetky e-maily na jednu adresu (pôvodný príjemca je v predmete). V produkcii nevyplniť.
EMAIL_REDIRECT_TO=
# Odosielateľ, keď bude overená doména klienta (inak testovacia doména Resend).
EMAIL_FROM=
# Tajomstvo, ktorým pg_cron volá /api/jobs/run (rovnaká hodnota je vo Vault ako cron_secret).
CRON_SECRET=

# Cloudflare Turnstile (captcha) — widget booking-platform
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push (modul push, Z33) — kľúče VAPID: `npx web-push generate-vapid-keys`. Súkromný len na serveri.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt pre push služby (mailto: alebo https:).
VAPID_SUBJECT=
