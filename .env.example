# Skopíruj do .env.local a doplň hodnoty (Supabase → Project Settings → API). Nikdy necommitovať .env*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Len na serveri (seed, riadiace centrum, cron). Nikdy nie s prefixom NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Doména platformy, z ktorej sa odvodzujú subdomény klientov (napr. booking.obrazne.sk).
NEXT_PUBLIC_PLATFORM_DOMAIN=
# Lokálny vývoj: klient, ktorý sa použije na localhost (slug z tabuľky tenant_domains).
DEV_TENANT_HOST=
