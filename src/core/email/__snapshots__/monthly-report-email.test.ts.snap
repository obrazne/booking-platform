// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`monthly report e-mail (Z62, doska 13) > subject with revenue and savings, the page in short, PDF attached — HTML snapshot 1`] = `
"<!doctype html><html><body style="margin:0;background:#f6f5f1;font-family:Roboto,Helvetica,Arial,sans-serif;color:#1d1d1b">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:32px 16px">
<table role="presentation" width="100%" style="max-width:560px;background:#fff;border:1px solid #e9e5db;border-radius:24px" cellpadding="0" cellspacing="0"><tr><td style="padding:24px 32px;border-bottom:1px solid #e9e5db"><p style="margin:0;font-size:17px;font-weight:700;color:#2f5d50">Chalet STRÖMY · Mesačný výpis</p></td></tr><tr><td style="padding:32px">
<h1 style="font-size:22px;line-height:1.3;margin:0 0 20px">Priamo 6 300 €. Bez provízie.</h1>
<p style="margin:0 0 14px;line-height:1.6">Dobrý deň, Jana, takto vyzeral september:</p>
<div style="margin:0 0 18px;padding:16px 18px;border-radius:14px;background:#eef3f0"><p style="margin:0 0 4px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#5a6672">Váš rozpočet na vlastný marketing tento mesiac</p><p style="margin:0 0 6px;font-size:28px;font-weight:800;color:#2f5d50">945 €</p><p style="margin:0;color:#3b3d42">Podiel priamych nocí 47 %.</p></div>
<table role="presentation" width="100%" style="margin:8px 0 18px;border-top:1px solid #e9e5db" cellpadding="0" cellspacing="0"><tr><td style="padding:8px 0;border-bottom:1px solid #e9e5db;color:#6e6e73">Obsadenosť</td><td style="padding:8px 0;border-bottom:1px solid #e9e5db;text-align:right">63 % · 19 z 30 nocí, aj portály</td></tr><tr><td style="padding:8px 0;border-bottom:1px solid #e9e5db;color:#6e6e73">Priemerná cena za noc</td><td style="padding:8px 0;border-bottom:1px solid #e9e5db;text-align:right">700 €</td></tr><tr><td style="padding:8px 0;border-bottom:1px solid #e9e5db;color:#6e6e73">Pobyty</td><td style="padding:8px 0;border-bottom:1px solid #e9e5db;text-align:right">2 priame · 3 z portálov</td></tr><tr><td style="padding:8px 0;border-bottom:1px solid #e9e5db;color:#6e6e73">Za vás odpracované</td><td style="padding:8px 0;border-bottom:1px solid #e9e5db;text-align:right">5 hodín urobil systém sám.</td></tr></table>
<p style="margin:0 0 14px;line-height:1.6">Potrebovalo vás: 2 kliky „Platba prijatá“, 1 odpoveď hosťovi.</p>
<p style="margin:0 0 14px;line-height:1.6">V mesiaci október máte zatiaľ 1 400 € potvrdených. Voľné víkendy: 9.–11. 10. · 23.–25. 10..</p>
<p style="margin:28px 0"><a href="https://app.example.invalid/admin/statistics/report?month=2026-09" style="background:#2f5d50;color:#fff;text-decoration:none;padding:12px 22px;border-radius:999px;display:inline-block;font-weight:500">Otvoriť celý výpis</a></p>
</td></tr><tr><td style="padding:20px 32px;border-top:1px solid #e9e5db;font-size:14px;line-height:1.5"><p style="margin:0;color:#6e6e73;font-size:13px">Výpis v PDF je v prílohe — môžete ho rovno preposlať účtovníkovi. Rozpočet na marketing = tržby z priamych pobytov × provízia 15 % z vašich nastavení. Výpis chodí 1. dňa v mesiaci; vypnúť ho môžete v Nastaveniach → E-maily a upozornenia.</p></td></tr></table></td></tr></table></body></html>"
