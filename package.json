    "e2e:server": "node scripts/e2e-server.mjs",
    "demo-data": "node scripts/demo-data.mjs",
    "tour:screens": "node scripts/tour-screens.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
